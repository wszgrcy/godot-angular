{
  "name": "godot-angular",
  "private": true,
  "version": "0.0.0",
  "description": "Run Angular inside Godot (GodotJS / V8) by rendering Control subclasses",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build:lib": "ng build library",
    "gen:html-data": "tsx tools/gen-html-data.ts",
    "build:builder": "tsx tools/vite-build.ts && tsx tools/gen-schema.ts && tsx tools/build-cli-schema.ts",
    "build": "pnpm run build:lib && pnpm run build:builder && pnpm run gen:html-data",
    "refresh": "pnpm run build && npm pack && pnpm install",
    "bootstrap": "pnpm install --filter . && pnpm run gen:typings && pnpm run build && pnpm install",
    "setup:ci": "pnpm install --frozen-lockfile --filter . && pnpm run gen:typings && pnpm run refresh",
    "gen:schema": "tsx tools/gen-schema.ts",
    "dump:vocabulary": "tsx tools/dump-vocabulary.ts",
    "gen:typings": "tsx tools/gen-typings.ts",
    "check:schema": "tsx tools/gen-schema.ts --check && tsx tools/build-cli-schema.ts --check",
    "test": "pnpm run refresh && pnpm run test:ci",
    "test:ci": "cross-env CUJ_COVERAGE_PACKAGE=1 pnpm --filter test-app test",
    "demo": "pnpm run build && tsx tools/run-demo.ts",
    "demo:window": "pnpm run build && tsx tools/run-demo.ts --window",
    "test:node": "vitest run --config vitest.node.config.mts",
    "test:all": "pnpm run test:node && pnpm run test",
    "typecheck": "pnpm run typecheck:lib && pnpm run typecheck:css && pnpm run typecheck:builder && pnpm run typecheck:demo && pnpm run typecheck:test-app && pnpm run typecheck:tools",
    "typecheck:lib": "tsc -p packages/library/tsconfig.json --noEmit",
    "typecheck:css": "tsc -p packages/css/tsconfig.json --noEmit",
    "typecheck:builder": "tsc -p packages/builder/tsconfig.json --noEmit",
    "typecheck:demo": "pnpm --filter demo typecheck",
    "typecheck:test-app": "pnpm --filter test-app typecheck",
    "typecheck:tools": "tsc -p tools/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@angular-devkit/architect": "0.2202.1",
    "@angular-devkit/core": "22.2.1",
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@babel/core": "^8.0.5",
    "@babel/plugin-transform-unicode-regex": "^8.0.1",
    "@nberlette/utf8": "^0.4.1",
    "@rolldown/pluginutils": "^1.0.1",
    "@types/is-relative": "^1.0.2",
    "@types/istanbul-lib-instrument": "^1.7.8",
    "@types/node": "^22.0.0",
    "@types/normalize-path": "^3.0.2",
    "@types/picomatch": "^4.0.3",
    "@types/ws": "^8.18.2",
    "@valibot/to-json-schema": "^1.8.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "abortcontroller-polyfill": "^1.7.8",
    "birpc": "4.2.0",
    "commander": "^15.0.0",
    "cross-env": "^10.1.0",
    "event-target-shim": "^6.0.2",
    "fast-xml-parser": "^5.11.2",
    "flatted": "3.4.4",
    "is-relative": "^1.0.0",
    "istanbul-lib-instrument": "^6.0.3",
    "magic-string": "^0.30.21",
    "ng-packagr": "22.2.4",
    "normalize-path": "^3.0.0",
    "picomatch": "^4.0.7",
    "rxjs": "7.8.2",
    "rxjs-for-await": "^1.0.0",
    "tinyglobby": "^0.2.17",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "valibot": "^1.5.0",
    "vite": "8.3.0",
    "vitest": "^4.1.11",
    "ws": "^8.22.0"
  }
}
