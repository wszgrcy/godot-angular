{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "outDir": "../../dist/builder",
    "declaration": true,
    "emitDeclarationOnly": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": ["./typings", "../../node_modules/@types"],
    "types": ["node", "godot"],
    "paths": {
      // event-target-shim 的 package.json exports 没给 types 分支，bundler 解析下会退化成 any
      "event-target-shim": ["../../node_modules/event-target-shim/index.d.ts"],
      // 对应 builder 源码里那三处 `godot-angular/*` 导入（vite/css-plugin.ts 引 css，
      // vitest/runtime/index.ts 引 polyfills 与 testing）：它们是**发布物说明符**，vite
      // 打包时保持 external，运行时由使用方的 node_modules 解析。类型这一侧仓库根没有
      // node_modules/godot-angular 可走（那目录只有构建后才有），所以逐条指到 dist/types：
      // 消费的是产物类型而不是源码，exports 写错当场就炸。
      // 产物内部的互引（testing.d.ts → core → css）不用在这里列：它们靠 dist/package.json
      // 的 exports 自引用解析（实测 --traceResolution），多写一条 core 映射是多余的。
      "godot-angular/css": ["../../dist/types/godot-angular-css.d.ts"],
      "godot-angular/testing": ["../../dist/types/godot-angular-testing.d.ts"]
    }
  },
  "include": [
    "application/**/*.ts",
    "shared/**/*.ts",
    "typings-gen/**/*.ts",
    "vite/**/*.ts",
    "vitest/build/**/*.ts",
    "vitest/node/**/*.ts",
    "vitest/runtime/**/*.ts"
  ],
  "exclude": ["**/test/**"]
}
