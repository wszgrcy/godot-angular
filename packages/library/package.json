{
  "name": "godot-angular",
  "version": "0.0.0",
  "description": "Run Angular inside Godot (GodotJS / V8) by rendering Control subclasses",
  "license": "MIT",
  "type": "module",
  "builders": "./builder/builders.json",
  "bin": {
    "godot-typings": "./builder/typings-gen/cli.mjs"
  },
  "exports": {
    "./forms": {
      "types": "./types/godot-angular-forms.d.ts",
      "default": "./fesm2022/godot-angular-forms.mjs"
    },
    "./testing": {
      "types": "./types/godot-angular-testing.d.ts",
      "default": "./fesm2022/godot-angular-testing.mjs"
    },
    "./vitest": {
      "types": "./builder/vitest/node/index.d.ts",
      "default": "./builder/vitest/node/index.mjs"
    },
    "./vitest/runtime": {
      "types": "./builder/vitest/runtime/index.d.ts",
      "default": "./builder/vitest/runtime/index.mjs"
    },
    "./builders.json": "./builder/builders.json",
    "./builder/*": "./builder/*",
    "./package.json": "./package.json"
  },
  "sideEffects": true,
  "dependencies": {
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@angular-devkit/architect": "0.2202.1",
    "@angular-devkit/core": "22.2.1",
    "@angular/build": "22.2.1",
    "@babel/core": "^8.0.0",
    "@babel/plugin-transform-unicode-regex": "^8.0.0",
    "@nberlette/utf8": "^0.4.1",
    "@rolldown/pluginutils": "^1.0.1",
    "abortcontroller-polyfill": "^1.7.8",
    "commander": "^15.0.0",
    "event-target-shim": "^6.0.2",
    "flatted": "^3.4.4",
    "is-relative": "^1.0.0",
    "magic-string": "^0.30.21",
    "normalize-path": "^3.0.0",
    "picomatch": "^4.0.7",
    "tinyglobby": "^0.2.17",
    "valibot": "^1.5.0",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@vitest/coverage-istanbul": "^4.1.0",
    "birpc": "^4.0.0",
    "istanbul-lib-instrument": "^6.0.0",
    "rxjs": "^7.4.0",
    "rxjs-for-await": "^1.0.0",
    "typescript": "^5.0.0 || ^6.0.0",
    "vitest": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/forms": {
      "optional": true
    },
    "@vitest/coverage-istanbul": {
      "optional": true
    },
    "birpc": {
      "optional": true
    },
    "istanbul-lib-instrument": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "allowedNonPeerDependencies": [
    "@analogjs/vite-plugin-angular",
    "@angular-devkit/architect",
    "@angular-devkit/core",
    "@angular/build",
    "@nberlette/utf8",
    "@rolldown/pluginutils",
    "abortcontroller-polyfill",
    "commander",
    "esbuild",
    "event-target-shim",
    "flatted",
    "normalize-path",
    "picomatch",
    "tinyglobby",
    "valibot",
    "vite",
    "ws"
  ]
}
