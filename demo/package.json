{
  "name": "demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "godot-angular 的示例工程。整个目录可复制走：自带 angular.json / tsconfig / Godot 工程文件。",
  "scripts": {
    "build": "ng build demo",
    "build:dev": "ng build demo --configuration development",
    "pages": "ng run demo:pages",
    "test": "ng test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typings": "godot-typings --out typings --bin ../bin"
  },
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "godot-angular": "file:../dist/godot-angular-0.0.0.tgz",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
