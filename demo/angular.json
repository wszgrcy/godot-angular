{
  "$schema": "./node_modules/godot-angular/builder/config/schema.json",
  "version": 1,
  "projects": {
    "demo": {
      "projectType": "application",
      "root": "src",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "godot-angular:application",
          "options": {
            "entries": ["src/main.ts"],
            "tsConfig": "tsconfig.json",
            "outputPath": "dist",
            "resRoot": "res://dist",
            "styles": ["src/global.css"],
            "optimization": false,
            "sourceMap": false
          },
          "configurations": {
            "development": { "optimization": false },
            "production": { "optimization": true }
          },
          "defaultConfiguration": "development"
        },
        "pages": {
          "builder": "godot-angular:application",
          "options": {
            "entries": [{ "glob": "**/*.ts", "input": "src/pages" }],
            "tsConfig": "tsconfig.json",
            "outputPath": "dist-pages",
            "resRoot": "res://dist-pages"
          }
        },
        "test": {
          "builder": "godot-angular:vitest",
          "options": {
            "tsConfig": "tsconfig.json",
            "outputPath": "dist-engine-test",
            "resRoot": "res://dist-engine-test",
            "optimization": false,
            "sourceMap": false,
            "specInclude": ["src/tests/engine/*.spec.ts"],
            "engine": {
              "projectPath": ".",
              "scene": "res://engine_vitest.tscn",
              "connectTimeout": 30000,
              "godotBin": "../bin"
            }
          }
        }
      }
    }
  }
}
