{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": false,
    "importHelpers": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "typeRoots": ["./typings"],
    "types": ["godot"]
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictTemplates": false
  },
  "include": ["src/**/*.ts"]
}
