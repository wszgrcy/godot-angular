{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": false,
    "importHelpers": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": []
  },
  // 顶层键，不是 compilerOptions 的子键；放进去 tsc 会报 TS5023
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictTemplates": true
  },
  "include": ["src/**/*.ts"]
}
